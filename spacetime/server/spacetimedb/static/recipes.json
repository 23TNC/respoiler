[
  {
    "id": "Forest_Work_Health",
    "input": [ 
      { "Forest": { "ge": [ "input[1].tracker.cost", "0" ] } }, 
      { "Work": {
          "and": [
            { "if": [ "input[2].status[ready]" ] },
            { "ge": [ { "dist": [ "input[0].tracker.linked_tile_id", "input[1].id" ] }, "0" ] }
          ]
        } 
      },
      { "Health": { "if": [ "input[3].status[ready]" ] } } 
    ],
    "craft_time": { "value": [ "30" ] },
    "on_start": [
      { "set": [ "input[2].status[ready]", "false" ] },
      { "set": [ "input[2].status[progress_visible]", "true" ] },
    ],
    "on_complete": [
      {
        "if": [
          {
            "and": [
              { "if": [ "input[1].state[trees]" ] },
              { "if": [ "input[3].state[woodcutter]" ] }
            ]
          },
          {
            "give": [ "input[0].id", "log", { "rand": [ "2", "5" ] } ]
          }
        ]
      },
      {
        "if": [
          {
            "and": [
              { "if": [ "input[1].state[food]" ] },
              { "if": [ "input[3].state[forager]" ] }
            ]
          },
          {
            "give": [ "input[0].id", "food", { "rand": [ "1", "3" ] } ]
          }
        ]
      },
      {
        "enqueue": [ "fatigue_health", "input[3].id" ]
      },
      { "set": [ "input[2].status[ready]", "true" ] },
      { "set": [ "input[2].status[progress_visible]", "false" ] },
    ]
  },
  {
    "id": "fatigue_health",
    "input": [
      { "Health": { "if": [ "input[1].status[ready]" ] } }
    ],
    "craft_time": { "value": [ "30" ] },
    "on_start": [
      { "set": [ "input[1].status[ready]", "false" ] },
      { "set": [ "input[1].status[progress_visible]", "true" ] },
    ],
    "on_complete": [
      { "set": [ "input[1].status[ready]", "true" ] },
      { "set": [ "input[1].status[progress_visible]", "false" ] },
    ]
  }
]